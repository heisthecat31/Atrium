From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: he_is_the_cat <125207670+heisthecat31@users.noreply.github.com>
Date: Sun, 1 Nov 2026 19:00:00 +0000
Subject: [PATCH] Atrium: don't track the Rift headset when it's only the radio

With another headset (Atrium's Mix & match, TouchLink with an Index) the Rift
lies out of view and only lends its radio to the Touches. The tracker still
searched for it in every frame and now and then took a Touch's LEDs for it
(the room view showed the headset at a Touch, and that Touch lost those
LEDs). ATRIUM_RIFT_HMD_UNTRACKED=1 (set by Atrium and TouchLink) leaves the
headset out of the tracker; the Touches still share the tracker's space.
---
diff --git a/src/xrt/drivers/rift/rift_driver.c b/src/xrt/drivers/rift/rift_driver.c
--- a/src/xrt/drivers/rift/rift_driver.c
+++ b/src/xrt/drivers/rift/rift_driver.c
@@ -65,6 +65,7 @@
 DEBUG_GET_ONCE_BOOL_OPTION(rift_power_override, "RIFT_POWER_OVERRIDE", false)
 DEBUG_GET_ONCE_FLOAT_OPTION(rift_startup_wait_time, "RIFT_STARTUP_WAIT_TIME", 5.0f)
 DEBUG_GET_ONCE_BOOL_OPTION(rift_enable_back_strap_leds, "RIFT_ENABLE_BACK_STRAP_LEDS", false)
+DEBUG_GET_ONCE_BOOL_OPTION(atrium_rift_hmd_untracked, "ATRIUM_RIFT_HMD_UNTRACKED", false)
 
 //! LEDs further behind the origin than this, along the device's backward (+Z) axis, are considered part of the back
 //! strap and disabled by @ref rift_upload_back_strap_disable_pattern.
@@ -952,7 +953,7 @@
 {
 	struct rift_hmd *hmd = rift_hmd_from_node(node);
 
-	if (hmd->constellation_tracker) {
+	if (hmd->constellation_tracker && hmd->use_constellation_poses) {
 		t_constellation_tracker_remove_device(hmd->constellation_tracker, hmd->constellation_device_id);
 	}
 
@@ -1550,11 +1551,19 @@
 
 	hmd->constellation_tracker = tracker;
 
-	int ret = t_constellation_tracker_add_device(tracker, &params, &hmd->constellation_device,
-	                                             &hmd->constellation_device_id);
-	if (ret < 0) {
-		HMD_ERROR(hmd, "Failed to add Rift HMD to constellation tracker, reason %d", ret);
-		return ret;
+	// Atrium: with another headset (Mix & match, TouchLink) the Rift is only the Touches' radio, lying out of
+	// view. Searched for anyway, a Touch's LEDs got taken for it now and then (and those LEDs went missing from the
+	// Touch). The Touches still share the tracker's space below.
+	bool untracked = debug_get_bool_option_atrium_rift_hmd_untracked();
+	if (!untracked) {
+		int ret = t_constellation_tracker_add_device(tracker, &params, &hmd->constellation_device,
+		                                             &hmd->constellation_device_id);
+		if (ret < 0) {
+			HMD_ERROR(hmd, "Failed to add Rift HMD to constellation tracker, reason %d", ret);
+			return ret;
+		}
+	} else {
+		HMD_INFO(hmd, "Rift headset not tracked (ATRIUM_RIFT_HMD_UNTRACKED): only its radio is used");
 	}
 
 	struct xrt_tracking_origin *tracking_origin = t_constellation_tracker_get_tracking_origin(tracker);
@@ -1570,7 +1579,7 @@
 	os_mutex_unlock(&hmd->device_mutex);
 
 	// Mark that we're using constellation poses now
-	hmd->use_constellation_poses = true;
+	hmd->use_constellation_poses = !untracked;
 
 	return 0;
 }
