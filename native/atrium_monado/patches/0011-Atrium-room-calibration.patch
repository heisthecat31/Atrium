+
+	/*!
+	 * Atrium: room calibration progress, called from tracker threads (keep it short). For each camera solved
+	 * from shared sightings: how many sightings it has, and its pose once solved (@p solved) or refined.
+	 */
+	void (*room_update)(void *userdata,
+	                    size_t mosaic_index,
+	                    size_t camera_index,
+	                    uint32_t sightings,
+	                    bool solved,
+	                    const struct xrt_pose *pose_in_origin);
+	void *room_userdata;
+
+	//! Atrium: every device pose a placed camera finds, in the origin (the room view shows them). Optional.
+	void (*device_seen)(void *userdata, uint32_t device_id, int64_t timestamp_ns, const struct xrt_pose *pose);
 };
 
