+#ifdef XRT_BUILD_DRIVER_RIFT_SENSOR
+/*
+ *
+ * Atrium: room calibration. The first sensor is the reference; every other one gets its pose from the
+ * constellation tracker (devices both see at once) and keeps it refined. The poses are kept by sensor serial in
+ * <config>/Atrium/rift_room.json (Windows: %APPDATA%\Atrium), which the Atrium app shows, and loaded at start, so a
+ * room is solved once. A missing reference sensor means a new room: everything else is solved again.
+ *
+ */
+
+#include "os/os_threading.h"
+#include "util/u_time.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#ifdef _WIN32
+#include <direct.h>
+#else
+#include <sys/stat.h>
+#define _mkdir(path) mkdir(path, 0755)
+#endif
+
+//! A sensor's key in the room file: its USB serial ("sensor<n>" if it has none).
+static const char *
+rift_room_serial(struct rift_sensor *sensor, size_t n, char *buf, size_t size)
+{
+	const char *serial = rift_sensor_get_frame_server(sensor)->serial;
+	if (serial[0] == '\0') {
+		snprintf(buf, size, "sensor%zu", n);
+		return buf;
+	}
+	return serial;
+}
+
+struct rift_room_sensor
+{
+	char serial[32];
+	bool reference;
+	bool placed;
+	uint32_t sightings;
+	struct xrt_pose pose;
+};
+
+static struct
+{
+	struct os_mutex lock;
+	bool lock_ready;
+	char path[1024];
+	struct rift_room_sensor sensors[XRT_TRACKING_MAX_CAMS];
+	size_t count;
+} rift_room;
+
+static void
+rift_room_path(void)
+{
+	const char *base = getenv("APPDATA");
+	if (base != NULL && base[0] != '\0') {
+		snprintf(rift_room.path, sizeof(rift_room.path), "%s\\Atrium", base);
+		_mkdir(rift_room.path);
+		snprintf(rift_room.path, sizeof(rift_room.path), "%s\\Atrium\\rift_room.json", base);
+		return;
+	}
+	const char *xdg = getenv("XDG_CONFIG_HOME"), *home = getenv("HOME");
+	if (xdg != NULL && xdg[0] != '\0') {
+		snprintf(rift_room.path, sizeof(rift_room.path), "%s/atrium/rift_room.json", xdg);
+	} else {
+		snprintf(rift_room.path, sizeof(rift_room.path), "%s/.config/atrium/rift_room.json", home ? home : ".");
+	}
+}
+
+//! The saved entry for @p serial (one sensor per line, as rift_room_write writes it), false if none.
+static bool
+rift_room_read(const char *serial, struct rift_room_sensor *out)
+{
+	FILE *f = fopen(rift_room.path, "r");
+	if (f == NULL) {
+		return false;
+	}
+	char line[512], key[48];
+	snprintf(key, sizeof(key), "\"serial\": \"%s\"", serial);
+	bool found = false;
+	while (!found && fgets(line, sizeof(line), f)) {
+		const char *pose = strstr(line, "\"pose\": [");
+		if (strstr(line, key) == NULL || pose == NULL) {
+			continue;
+		}
+		struct xrt_pose p;
+		if (sscanf(pose + 9, "%f, %f, %f, %f, %f, %f, %f", &p.position.x, &p.position.y, &p.position.z,
+		           &p.orientation.x, &p.orientation.y, &p.orientation.z, &p.orientation.w) != 7) {
+			continue;
+		}
+		snprintf(out->serial, sizeof(out->serial), "%s", serial);
+		out->reference = strstr(line, "\"reference\": true") != NULL;
+		out->placed = strstr(line, "\"placed\": true") != NULL;
+		out->pose = p;
+		found = true;
+	}
+	fclose(f);
+	return found;
+}
+
+//! Call with the lock held.
+static void
+rift_room_write(void)
+{
+	char tmp[1040];
+	snprintf(tmp, sizeof(tmp), "%s.tmp", rift_room.path);
+	FILE *f = fopen(tmp, "w");
+	if (f == NULL) {
+		return;
+	}
+	fprintf(f, "{\n  \"updated\": %lld,\n  \"sensors\": [\n", (long long)time(NULL));
+	for (size_t i = 0; i < rift_room.count; i++) {
+		const struct rift_room_sensor *s = &rift_room.sensors[i];
+		fprintf(f,
+		        "    {\"serial\": \"%s\", \"reference\": %s, \"placed\": %s, \"sightings\": %u, \"pose\": [%f, %f, "
+		        "%f, %f, %f, %f, %f]}%s\n",
+		        s->serial, s->reference ? "true" : "false", s->placed ? "true" : "false", s->sightings,
+		        s->pose.position.x, s->pose.position.y, s->pose.position.z, s->pose.orientation.x,
+		        s->pose.orientation.y, s->pose.orientation.z, s->pose.orientation.w,
+		        i + 1 < rift_room.count ? "," : "");
+	}
+	fprintf(f, "  ]\n}\n");
+	fclose(f);
+	remove(rift_room.path);
+	rename(tmp, rift_room.path);
+}
+
+static void
+rift_room_update(void *userdata,
+                 size_t mosaic_index,
+                 size_t camera_index,
+                 uint32_t sightings,
+                 bool solved,
+                 const struct xrt_pose *pose_in_origin)
+{
+	(void)userdata;
+	(void)mosaic_index;
+	if (camera_index >= rift_room.count) {
+		return;
+	}
+	os_mutex_lock(&rift_room.lock);
+	struct rift_room_sensor *s = &rift_room.sensors[camera_index];
+	s->sightings = sightings;
+	if (solved) {
+		s->placed = true;
+		s->pose = *pose_in_origin;
+	}
+	rift_room_write();
+	os_mutex_unlock(&rift_room.lock);
+}
+
+/*
+ * The devices the sensors see right now (the headset is the tracker's device 0, the Touches follow), written to
+ * rift_live.json next to rift_room.json about 10 times a second for the Atrium app's room view.
+ */
+#define RIFT_LIVE_DEVICES 8
+
+static struct
+{
+	struct xrt_vec3 position[RIFT_LIVE_DEVICES];
+	int64_t seen_ns[RIFT_LIVE_DEVICES];
+	int64_t written_ns;
+} rift_live;
+
+static void
+rift_live_seen(void *userdata, uint32_t device_id, int64_t timestamp_ns, const struct xrt_pose *pose)
+{
+	(void)userdata;
+	if (device_id >= RIFT_LIVE_DEVICES || !rift_room.lock_ready) {
+		return;
+	}
+	os_mutex_lock(&rift_room.lock);
+	rift_live.position[device_id] = pose->position;
+	rift_live.seen_ns[device_id] = timestamp_ns;
+	if (timestamp_ns - rift_live.written_ns >= 100 * U_TIME_1MS_IN_NS) {
+		rift_live.written_ns = timestamp_ns;
+		char path[1040], tmp[1050];
+		snprintf(path, sizeof(path), "%s", rift_room.path);
+		char *name = strstr(path, "rift_room.json");
+		if (name != NULL) {
+			strcpy(name, "rift_live.json");
+			snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+			FILE *f = fopen(tmp, "w");
+			if (f != NULL) {
+				fprintf(f, "{\"devices\": [");
+				bool first = true;
+				for (uint32_t i = 0; i < RIFT_LIVE_DEVICES; i++) {
+					if (rift_live.seen_ns[i] == 0) {
+						continue;
+					}
+					fprintf(f, "%s{\"id\": %u, \"pos\": [%f, %f, %f], \"age_ms\": %lld}", first ? "" : ", ", i,
+					        rift_live.position[i].x, rift_live.position[i].y, rift_live.position[i].z,
+					        (long long)((timestamp_ns - rift_live.seen_ns[i]) / U_TIME_1MS_IN_NS));
+					first = false;
+				}
+				fprintf(f, "]}\n");
+				fclose(f);
+				remove(path);
+				rename(tmp, path);
+			}
+		}
+	}
+	os_mutex_unlock(&rift_room.lock);
+}
+#endif
