From b6f34ad65fbb02b25199f881baa0203442c26fce Mon Sep 17 00:00:00 2001
From: he_is_the_cat <125207670+heisthecat31@users.noreply.github.com>
Date: Wed, 21 Oct 2026 16:24:46 +0100
Subject: [PATCH 7/7] Atrium: Rift Touch position tracking through the
 constellation tracker

The Touch calibration's LED points (relative to the IMU, as OpenHMD uses them)
become a constellation LED model; each Touch joins the HMD's tracker once its
calibration is in. Pose = IMU rotation turned onto the cameras' frame (slow
slerp toward each optical rotation) + optical position, held 2 s when lost.
---
 src/xrt/drivers/rift/rift_driver.c   |   8 +
 src/xrt/drivers/rift/rift_internal.h |  26 +++
 src/xrt/drivers/rift/rift_radio.c    | 285 ++++++++++++++++++++++++++-
 3 files changed, 312 insertions(+), 7 deletions(-)

diff --git a/src/xrt/drivers/rift/rift_driver.c b/src/xrt/drivers/rift/rift_driver.c
index 489ca1ddc..7419b60f7 100644
--- a/src/xrt/drivers/rift/rift_driver.c
+++ b/src/xrt/drivers/rift/rift_driver.c
@@ -1561,6 +1561,14 @@ rift_add_to_constellation_tracker(struct rift_hmd *hmd, struct t_constellation_t
 	hmd->base.tracking_origin = tracking_origin;
 	hmd->constellation_imu_sink = params.imu_sink;
 
+	// Atrium: radio devices made before this share the HMD's space; the Touches join the tracker themselves once
+	// their calibration is in (rift_radio.c).
+	os_mutex_lock(&hmd->device_mutex);
+	for (int i = 0; i < hmd->device_count; i++) {
+		hmd->devices[i]->tracking_origin = tracking_origin;
+	}
+	os_mutex_unlock(&hmd->device_mutex);
+
 	// Mark that we're using constellation poses now
 	hmd->use_constellation_poses = true;
 
