+/*
+ * Atrium: optical tracking of the Touch through the HMD's constellation tracker.
+ */
+
+//! An optical pose younger than this counts as tracked position.
+#define RIFT_TOUCH_OPTICAL_FRESH_NS (100 * U_TIME_1MS_IN_NS)
+//! The last optical position is held (valid, not tracked) for this long after the cameras lose the Touch.
+#define RIFT_TOUCH_OPTICAL_HOLD_NS (2000 * U_TIME_1MS_IN_NS)
+//! Only an optical pose this fresh is handed back to the tracker as the prior.
+#define RIFT_TOUCH_PRIOR_MAX_AGE_NS (250 * U_TIME_1MS_IN_NS)
+//! Optical position is extrapolated at most this far past the last optical pose.
+#define RIFT_TOUCH_MAX_PREDICT_NS (50 * U_TIME_1MS_IN_NS)
+//! How far each optical pose pulls the IMU rotation towards the cameras' rotation.
+#define RIFT_TOUCH_CORRECTION_ALPHA 0.05f
+
+/*!
+ * The Touch pose: IMU rotation turned into the cameras' frame, with the cameras' position. Before the first optical
+ * pose this is the plain IMU rotation, as before Atrium added optical tracking.
+ */
+static bool
+rift_touch_controller_get_fused_relation(struct rift_touch_controller *controller,
+                                         int64_t at_timestamp_ns,
+                                         bool for_prior,
+                                         struct xrt_space_relation *out_relation)
+{
+	struct xrt_space_relation relation = XRT_SPACE_RELATION_ZERO;
+	struct xrt_quat imu_orientation;
+	struct xrt_vec3 angular_velocity;
+
+	os_mutex_lock(&controller->input.mutex);
+	int ret = imu_fusion_get_prediction(controller->input.imu_fusion, (uint64_t)at_timestamp_ns, &imu_orientation,
+	                                    &angular_velocity);
+	bool have_correction = controller->tracking.have_correction;
+	struct xrt_quat correction = controller->tracking.correction;
+	os_mutex_unlock(&controller->input.mutex);
+
+	if (ret != 0) {
+		return false;
+	}
+
+	if (!have_correction) {
+		if (for_prior) {
+			return false;
+		}
+		relation.pose.orientation = imu_orientation;
+		relation.angular_velocity = angular_velocity;
+		relation.relation_flags = XRT_SPACE_RELATION_ORIENTATION_VALID_BIT |
+		                          XRT_SPACE_RELATION_ORIENTATION_TRACKED_BIT |
+		                          XRT_SPACE_RELATION_ANGULAR_VELOCITY_VALID_BIT;
+		*out_relation = relation;
+		return true;
+	}
+
+	math_quat_rotate(&correction, &imu_orientation, &relation.pose.orientation);
+	math_quat_rotate_vec3(&correction, &angular_velocity, &relation.angular_velocity);
+	relation.relation_flags = XRT_SPACE_RELATION_ORIENTATION_VALID_BIT | XRT_SPACE_RELATION_ORIENTATION_TRACKED_BIT |
+	                          XRT_SPACE_RELATION_ANGULAR_VELOCITY_VALID_BIT;
+
+	int64_t latest_ns;
+	struct xrt_space_relation latest;
+	if (m_relation_history_get_latest(controller->tracking.optical_hist, &latest_ns, &latest)) {
+		int64_t age_ns = at_timestamp_ns - latest_ns;
+		int64_t max_age_ns = for_prior ? RIFT_TOUCH_PRIOR_MAX_AGE_NS : RIFT_TOUCH_OPTICAL_HOLD_NS;
+
+		if (age_ns <= max_age_ns) {
+			int64_t query_ns = age_ns > RIFT_TOUCH_MAX_PREDICT_NS ? latest_ns + RIFT_TOUCH_MAX_PREDICT_NS
+			                                                      : at_timestamp_ns;
+			struct xrt_space_relation optical = latest;
+			m_relation_history_get(controller->tracking.optical_hist, query_ns, &optical);
+
+			relation.pose.position = optical.pose.position;
+			relation.relation_flags |= XRT_SPACE_RELATION_POSITION_VALID_BIT;
+
+			if (age_ns <= RIFT_TOUCH_OPTICAL_FRESH_NS) {
+				relation.relation_flags |= XRT_SPACE_RELATION_POSITION_TRACKED_BIT;
+				if (optical.relation_flags & XRT_SPACE_RELATION_LINEAR_VELOCITY_VALID_BIT) {
+					relation.linear_velocity = optical.linear_velocity;
+					relation.relation_flags |= XRT_SPACE_RELATION_LINEAR_VELOCITY_VALID_BIT;
+				}
+			}
+		}
+	}
+
+	if (for_prior && (relation.relation_flags & XRT_SPACE_RELATION_POSITION_VALID_BIT) == 0) {
+		return false;
+	}
+
+	*out_relation = relation;
+	return true;
+}
+
+static void
+rift_touch_controller_push_constellation_sample(struct t_constellation_tracker_device *device,
+                                                struct t_constellation_tracker_sample *sample)
+{
+	struct rift_touch_controller *controller =
+	    container_of(device, struct rift_touch_controller, tracking.device);
+
+	struct xrt_space_relation relation = XRT_SPACE_RELATION_ZERO;
+	relation.pose = sample->pose;
+	relation.relation_flags = XRT_SPACE_RELATION_ORIENTATION_VALID_BIT | XRT_SPACE_RELATION_ORIENTATION_TRACKED_BIT |
+	                          XRT_SPACE_RELATION_POSITION_VALID_BIT | XRT_SPACE_RELATION_POSITION_TRACKED_BIT;
+
+	// Samples from several sensors may arrive slightly out of order, older ones are dropped here.
+	if (!m_relation_history_push_with_motion_estimation(controller->tracking.optical_hist, &relation,
+	                                                    sample->timestamp_ns)) {
+		return;
+	}
+
+	struct xrt_space_relation imu_relation;
+	if (m_relation_history_get(controller->tracking.imu_hist, sample->timestamp_ns, &imu_relation) ==
+	    M_RELATION_HISTORY_RESULT_INVALID) {
+		return;
+	}
+
+	// The rotation that takes the IMU fusion's frame onto the cameras' frame.
+	struct xrt_quat imu_inverse;
+	struct xrt_quat target;
+	math_quat_invert(&imu_relation.pose.orientation, &imu_inverse);
+	math_quat_rotate(&sample->pose.orientation, &imu_inverse, &target);
+	math_quat_normalize(&target);
+
+	os_mutex_lock(&controller->input.mutex);
+	if (!controller->tracking.have_correction) {
+		controller->tracking.correction = target;
+		controller->tracking.have_correction = true;
+	} else {
+		struct xrt_quat blended;
+		math_quat_slerp(&controller->tracking.correction, &target, RIFT_TOUCH_CORRECTION_ALPHA, &blended);
+		math_quat_normalize(&blended);
+		controller->tracking.correction = blended;
+	}
+	os_mutex_unlock(&controller->input.mutex);
+}
+
+static void
+rift_touch_controller_get_constellation_prior(struct t_constellation_tracker_tracking_source *tracking_source,
+                                              int64_t when_ns,
+                                              struct xrt_space_relation *out_relation)
+{
+	struct rift_touch_controller *controller =
+	    container_of(tracking_source, struct rift_touch_controller, tracking.tracking_source);
+
+	struct xrt_space_relation relation = XRT_SPACE_RELATION_ZERO;
+	rift_touch_controller_get_fused_relation(controller, when_ns, true, &relation);
+	*out_relation = relation;
+}
+
+/*!
+ * Builds the tracker's LED model from the Touch calibration: the LED points, made relative to the IMU so the tracker
+ * reports the IMU frame. The Touch model is used as is (OpenHMD does the same); only the HMD's is turned around Y.
+ */
+static bool
+rift_touch_controller_build_led_model(struct rift_touch_controller *controller)
+{
+	struct rift_hmd *hmd = controller->hmd;
+	struct rift_touch_controller_calibration *c = &controller->input.calibration;
+
+	os_mutex_lock(&controller->input.mutex);
+
+	size_t led_count = c->num_leds;
+	if (led_count == 0 || led_count > XRT_CONSTELLATION_MAX_LEDS_PER_DEVICE) {
+		os_mutex_unlock(&controller->input.mutex);
+		HMD_ERROR(hmd, "Touch %d calibration has %zu LEDs, cannot track it", controller->device_type,
+		          led_count);
+		return false;
+	}
+
+	// The calibration is in meters; guard against a model in millimeters, which would never match.
+	float max_extent = 0.0f;
+	for (size_t i = 0; i < led_count; i++) {
+		struct xrt_vec3 p = m_vec3_sub(c->leds[i].position, c->imu_position);
+		max_extent = fmaxf(max_extent, fmaxf(fabsf(p.x), fmaxf(fabsf(p.y), fabsf(p.z))));
+	}
+	float scale = max_extent > 1.0f ? 0.001f : 1.0f;
+
+	struct t_constellation_tracker_led *leds = U_TYPED_ARRAY_CALLOC(struct t_constellation_tracker_led, led_count);
+	for (size_t i = 0; i < led_count; i++) {
+		struct xrt_vec3 normal = c->leds[i].normal;
+		math_vec3_normalize(&normal);
+
+		leds[i] = (struct t_constellation_tracker_led){
+		    .position = m_vec3_mul_scalar(m_vec3_sub(c->leds[i].position, c->imu_position), scale),
+		    .normal = normal,
+		    .radius_m = 0.0035f,                   // same as the HMD
+		    .visibility_angle = DEG_TO_RAD(80.0f), // TODO: tune on hardware
+		    .id = (t_constellation_led_id_it)i,
+		};
+	}
+
+	os_mutex_unlock(&controller->input.mutex);
+
+	controller->tracking.led_model = (struct t_constellation_tracker_led_model){
+	    .leds = leds,
+	    .led_count = led_count,
+	    .match_parameters =
+	        {
+	            .min_leds_for_correspondence_search_without_prior = 5,
+	            .min_leds_for_correspondence_search_with_prior = 4,
+	        },
+	};
+
+	HMD_INFO(hmd, "Touch %d LED model: %zu LEDs, %.1f mm from the IMU at most%s", controller->device_type,
+	         led_count, (double)(max_extent * scale * 1000.0f), scale != 1.0f ? " (scaled from mm)" : "");
+
+	return true;
+}
+
+/*!
+ * Adds the Touch to the HMD's constellation tracker once its calibration is in. Radio thread only.
+ */
+static void
+rift_touch_controller_try_add_to_constellation(struct rift_hmd *hmd, struct rift_touch_controller *controller)
+{
+	struct t_constellation_tracker *tracker = hmd->constellation_tracker;
+	if (controller->tracking.add_attempted || tracker == NULL || !controller->input.calibration_read) {
+		return;
+	}
+	controller->tracking.add_attempted = true;
+
+	if (!rift_touch_controller_build_led_model(controller)) {
+		return;
+	}
+
+	struct t_constellation_tracker_device_params params = {
+	    .led_model = controller->tracking.led_model,
+	    .tracking_source = &controller->tracking.tracking_source,
+	};
+
+	int ret = t_constellation_tracker_add_device(tracker, &params, &controller->tracking.device,
+	                                             &controller->tracking.device_id);
+	if (ret < 0) {
+		HMD_ERROR(hmd, "Failed to add Touch %d to the constellation tracker, reason %d", controller->device_type,
+		          ret);
+		return;
+	}
+
+	controller->base.tracking_origin = t_constellation_tracker_get_tracking_origin(tracker);
+	controller->tracking.added = true;
+
+	HMD_INFO(hmd, "Touch %d added to the constellation tracker as device %d", controller->device_type,
+	         controller->tracking.device_id);
+}
+
