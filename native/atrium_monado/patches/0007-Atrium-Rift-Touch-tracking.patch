+
+		//! Thread safe: IMU fusion orientation at each IMU sample, so optical samples can be matched in time.
+		struct m_relation_history *imu_hist;
+		//! Thread safe: raw optical poses of the IMU frame.
+		struct m_relation_history *optical_hist;
+
+		//! Locked by input.mutex: world-from-fusion rotation, valid after the first optical pose.
+		bool have_correction;
+		struct xrt_quat correction;
+	} tracking;
