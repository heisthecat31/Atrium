+	// Kept so optical poses, which arrive late, can be compared with the IMU rotation at their own time.
+	struct xrt_space_relation imu_relation = XRT_SPACE_RELATION_ZERO;
+	if (imu_fusion_get_prediction(controller->input.imu_fusion, (uint64_t)imu_sample.timestamp_ns,
+	                              &imu_relation.pose.orientation, &imu_relation.angular_velocity) == 0) {
+		imu_relation.relation_flags = XRT_SPACE_RELATION_ORIENTATION_VALID_BIT;
+		m_relation_history_push(controller->tracking.imu_hist, &imu_relation, imu_sample.timestamp_ns);
+	}
+
