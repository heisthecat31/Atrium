 endif()
+if(XRT_BUILD_DRIVER_ATRIUM_STREAM)
+	# Atrium: the streaming output (encode to the headset app), with the Atrium stream driver.
+	target_sources(
+		comp_main
+		PRIVATE ${PROJECT_SOURCE_DIR}/src/xrt/drivers/atrium_stream/atrium_stream_target.c
+			${PROJECT_SOURCE_DIR}/src/xrt/drivers/atrium_stream/atrium_stream_encoder.c
+		)
+	target_link_libraries(comp_main PRIVATE drv_atrium_stream)
+endif()
 if(VK_USE_PLATFORM_DISPLAY_KHR)
 	target_sources(comp_main PRIVATE comp_window_vk_display.c)
 endif()
