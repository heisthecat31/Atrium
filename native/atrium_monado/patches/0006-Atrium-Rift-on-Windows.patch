--- /dev/null
+++ b/src/xrt/auxiliary/os/os_hid_win32.c
@@ -0,0 +1,279 @@
+// Copyright 2026, Atrium contributors
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  Windows HID backend (Atrium): the hidraw semantics Monado's drivers expect, on the
+ *         Windows HID class driver.
+ *
+ * Like hidraw for devices with numbered reports, reads return the report id in the first byte
+ * and writes / feature reports take it there. Windows prefixes a 0 for devices without report
+ * ids; that byte is dropped on read, as hidraw does. A read that times out stays pending and its
+ * data is returned by the next read, so nothing is lost.
+ *
+ * @ingroup aux_os
+ */
+
+#include "xrt/xrt_config_os.h"
+
+#ifdef XRT_OS_WINDOWS
+
+#include "os/os_hid.h"
+#include "util/u_misc.h"
+
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <hidsdi.h>
+#include <hidpi.h>
+#include <setupapi.h>
+
+#include <ctype.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#pragma comment(lib, "hid.lib")
+#pragma comment(lib, "setupapi.lib")
+
+/*!
+ * @implements os_hid_device
+ */
+struct hid_win32
+{
+	struct os_hid_device base;
+
+	HANDLE handle;
+	USHORT input_len;
+	USHORT output_len;
+	USHORT feature_len;
+
+	OVERLAPPED read_ol;
+	bool read_pending;
+	uint8_t *read_buf;
+
+	OVERLAPPED write_ol;
+};
+
+static int
+os_hid_win32_read(struct os_hid_device *ohdev, uint8_t *data, size_t length, int milliseconds)
+{
+	struct hid_win32 *d = (struct hid_win32 *)ohdev;
+	DWORD got = 0;
+
+	if (!d->read_pending) {
+		memset(d->read_buf, 0, d->input_len);
+		ResetEvent(d->read_ol.hEvent);
+		if (!ReadFile(d->handle, d->read_buf, d->input_len, &got, &d->read_ol)) {
+			if (GetLastError() != ERROR_IO_PENDING) {
+				CancelIo(d->handle);
+				return -1;
+			}
+		}
+		d->read_pending = true;
+	}
+
+	DWORD wait = milliseconds < 0 ? INFINITE : (DWORD)milliseconds;
+	if (WaitForSingleObject(d->read_ol.hEvent, wait) != WAIT_OBJECT_0) {
+		return 0; // still pending: the next read picks it up
+	}
+	d->read_pending = false;
+	if (!GetOverlappedResult(d->handle, &d->read_ol, &got, FALSE)) {
+		return -1;
+	}
+	if (got == 0) {
+		return 0;
+	}
+
+	// Report id 0 means the device has no numbered reports: hidraw returns no id byte then.
+	const uint8_t *src = d->read_buf;
+	size_t n = got;
+	if (src[0] == 0) {
+		src++;
+		n--;
+	}
+	if (n > length) {
+		n = length;
+	}
+	memcpy(data, src, n);
+	return (int)n;
+}
+
+static int
+os_hid_win32_write(struct os_hid_device *ohdev, const uint8_t *data, size_t length)
+{
+	struct hid_win32 *d = (struct hid_win32 *)ohdev;
+
+	// Windows wants exactly the output report length.
+	size_t len = d->output_len > length ? d->output_len : length;
+	uint8_t *buf = U_TYPED_ARRAY_CALLOC(uint8_t, len);
+	memcpy(buf, data, length);
+
+	DWORD done = 0;
+	int ret = -1;
+	ResetEvent(d->write_ol.hEvent);
+	if (WriteFile(d->handle, buf, (DWORD)len, &done, &d->write_ol) || GetLastError() == ERROR_IO_PENDING) {
+		if (WaitForSingleObject(d->write_ol.hEvent, 1000) == WAIT_OBJECT_0 &&
+		    GetOverlappedResult(d->handle, &d->write_ol, &done, FALSE)) {
+			ret = (int)length;
+		} else {
+			CancelIo(d->handle);
+		}
+	}
+	free(buf);
+	return ret;
+}
+
+static int
+feature_get(struct hid_win32 *d, uint8_t *data, size_t length)
+{
+	size_t len = d->feature_len > length ? d->feature_len : length;
+	uint8_t *buf = U_TYPED_ARRAY_CALLOC(uint8_t, len);
+	buf[0] = data[0];
+	int ret = -1;
+	if (HidD_GetFeature(d->handle, buf, (ULONG)len)) {
+		size_t n = length < d->feature_len ? length : d->feature_len;
+		memcpy(data, buf, n);
+		ret = (int)n;
+	}
+	free(buf);
+	return ret;
+}
+
+static int
+os_hid_win32_get_feature(struct os_hid_device *ohdev, uint8_t report_num, uint8_t *data, size_t length)
+{
+	data[0] = report_num;
+	return feature_get((struct hid_win32 *)ohdev, data, length);
+}
+
+static int
+os_hid_win32_get_feature_timeout(struct os_hid_device *ohdev, void *data, size_t length, uint32_t timeout)
+{
+	struct hid_win32 *d = (struct hid_win32 *)ohdev;
+	int ret = -1;
+	for (uint32_t i = 0; i <= timeout; i++) {
+		ret = feature_get(d, (uint8_t *)data, length);
+		if (ret >= 0) {
+			break;
+		}
+		Sleep(1);
+	}
+	return ret;
+}
+
+static int
+os_hid_win32_set_feature(struct os_hid_device *ohdev, const uint8_t *data, size_t length)
+{
+	struct hid_win32 *d = (struct hid_win32 *)ohdev;
+	size_t len = d->feature_len > length ? d->feature_len : length;
+	uint8_t *buf = U_TYPED_ARRAY_CALLOC(uint8_t, len);
+	memcpy(buf, data, length);
+	int ret = HidD_SetFeature(d->handle, buf, (ULONG)len) ? (int)length : -1;
+	free(buf);
+	return ret;
+}
+
+static int
+os_hid_win32_get_physical_address(struct os_hid_device *ohdev, uint8_t *data, size_t length)
+{
+	(void)ohdev;
+	(void)data;
+	(void)length;
+	return -1;
+}
+
+static void
+os_hid_win32_destroy(struct os_hid_device *ohdev)
+{
+	struct hid_win32 *d = (struct hid_win32 *)ohdev;
+	CancelIo(d->handle);
+	CloseHandle(d->handle);
+	CloseHandle(d->read_ol.hEvent);
+	CloseHandle(d->write_ol.hEvent);
+	free(d->read_buf);
+	free(d);
+}
+
+int
+os_hid_open_win32(const char *path, struct os_hid_device **out_hid)
+{
+	HANDLE h = CreateFileA(path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+	                       OPEN_EXISTING, FILE_FLAG_OVERLAPPED, NULL);
+	if (h == INVALID_HANDLE_VALUE) {
+		return -(int)GetLastError();
+	}
+
+	PHIDP_PREPARSED_DATA pp = NULL;
+	HIDP_CAPS caps = {0};
+	if (!HidD_GetPreparsedData(h, &pp)) {
+		CloseHandle(h);
+		return -1;
+	}
+	HidP_GetCaps(pp, &caps);
+	HidD_FreePreparsedData(pp);
+
+	struct hid_win32 *d = U_TYPED_CALLOC(struct hid_win32);
+	d->base.read = os_hid_win32_read;
+	d->base.write = os_hid_win32_write;
+	d->base.get_feature = os_hid_win32_get_feature;
+	d->base.get_feature_timeout = os_hid_win32_get_feature_timeout;
+	d->base.set_feature = os_hid_win32_set_feature;
+	d->base.get_physical_address = os_hid_win32_get_physical_address;
+	d->base.destroy = os_hid_win32_destroy;
+	d->handle = h;
+	d->input_len = caps.InputReportByteLength;
+	d->output_len = caps.OutputReportByteLength;
+	d->feature_len = caps.FeatureReportByteLength;
+	d->read_buf = U_TYPED_ARRAY_CALLOC(uint8_t, d->input_len > 0 ? d->input_len : 1);
+	d->read_ol.hEvent = CreateEventA(NULL, TRUE, FALSE, NULL);
+	d->write_ol.hEvent = CreateEventA(NULL, TRUE, FALSE, NULL);
+
+	*out_hid = &d->base;
+	return 0;
+}
+
+int
+os_hid_find_win32(uint16_t vendor_id, uint16_t product_id, int interface, char *out_path, size_t out_size)
+{
+	GUID guid;
+	HidD_GetHidGuid(&guid);
+	HDEVINFO set = SetupDiGetClassDevsA(&guid, NULL, NULL, DIGCF_PRESENT | DIGCF_DEVICEINTERFACE);
+	if (set == INVALID_HANDLE_VALUE) {
+		return -1;
+	}
+
+	char want[32];
+	snprintf(want, sizeof(want), "vid_%04x&pid_%04x", vendor_id, product_id);
+	char want_mi[16];
+	snprintf(want_mi, sizeof(want_mi), "&mi_%02x", interface);
+
+	int ret = -1;
+	SP_DEVICE_INTERFACE_DATA ifd = {.cbSize = sizeof(ifd)};
+	for (DWORD i = 0; ret != 0 && SetupDiEnumDeviceInterfaces(set, NULL, &guid, i, &ifd); i++) {
+		DWORD need = 0;
+		SetupDiGetDeviceInterfaceDetailA(set, &ifd, NULL, 0, &need, NULL);
+		SP_DEVICE_INTERFACE_DETAIL_DATA_A *detail = malloc(need);
+		if (detail == NULL) {
+			continue;
+		}
+		detail->cbSize = sizeof(*detail);
+		if (SetupDiGetDeviceInterfaceDetailA(set, &ifd, detail, need, NULL, NULL)) {
+			char lower[512];
+			snprintf(lower, sizeof(lower), "%s", detail->DevicePath);
+			for (char *c = lower; *c; c++) {
+				*c = (char)tolower((unsigned char)*c);
+			}
+			// A composite device names the interface (&mi_xx); a single-interface one doesn't.
+			bool iface_ok = strstr(lower, "&mi_") ? strstr(lower, want_mi) != NULL : interface == 0;
+			if (strstr(lower, want) && iface_ok) {
+				snprintf(out_path, out_size, "%s", detail->DevicePath);
+				ret = 0;
+			}
+		}
+		free(detail);
+	}
+	SetupDiDestroyDeviceInfoList(set);
+	return ret;
+}
+
+#endif
diff --git a/src/xrt/auxiliary/util/u_file.cpp b/src/xrt/auxiliary/util/u_file.cpp
index 02425eba0..e1e86d81f 100644
--- a/src/xrt/auxiliary/util/u_file.cpp
+++ b/src/xrt/auxiliary/util/u_file.cpp
@@ -142,4 +142,33 @@ u_file_open_file_in_config_dir(const char *filename, const char *mode)
 	return nullptr;
 }
 
+FILE *
+u_file_open_file_in_config_dir_subpath(const char *subpath, const char *filename, const char *mode)
+{
+	auto config_path = get_config_path();
+	if (config_path.empty()) {
+		return NULL;
+	}
+
+	auto directory = config_path / subpath;
+	auto file_path_string = (directory / filename).string();
+	FILE *file = nullptr;
+	errno_t ret = fopen_s(&file, file_path_string.c_str(), mode);
+	if (ret == 0) {
+		return file;
+	}
+
+	// Try creating the path.
+	std::error_code ec;
+	fs::create_directories(directory, ec);
+
+	// Do not report error.
+	ret = fopen_s(&file, file_path_string.c_str(), mode);
+	if (ret == 0) {
+		return file;
+	}
+
+	return nullptr;
+}
+
 #endif // !XRT_OS_LINUX
