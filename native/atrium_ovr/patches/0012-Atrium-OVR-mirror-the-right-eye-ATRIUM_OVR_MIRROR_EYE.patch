+// Atrium OVR: ATRIUM_OVR_MIRROR_EYE=right swaps the eyes the game sees. Games that mirror their
+// first eye to the desktop window (Echo VR copies the left half of its eye texture) then show the
+// right eye there; frame submission swaps the views back, so the headset is unchanged and nothing
+// extra is drawn.
+static bool AtriumMirrorRight()
+{
+	static const bool right = [] {
+		char v[16] = {};
+		return GetEnvironmentVariableA("ATRIUM_OVR_MIRROR_EYE", v, sizeof(v)) && _stricmp(v, "right") == 0;
+	}();
+	return right;
+}
+
+// The runtime's eye for the game's eye (and back: the swap is its own inverse).
+static int AtriumEye(int eye)
+{
+	return AtriumMirrorRight() && (eye == ovrEye_Left || eye == ovrEye_Right) ? ovrEye_Right - eye : eye;
+}
