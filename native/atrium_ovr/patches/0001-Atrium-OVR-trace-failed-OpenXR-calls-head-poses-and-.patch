From 2dec972070170116b49734b267ed45733e15c379 Mon Sep 17 00:00:00 2001
From: Atrium <atrium@localhost>
Date: Tue, 20 Oct 2026 11:39:38 +0100
Subject: [PATCH 1/7] Atrium OVR: trace failed OpenXR calls, head poses and
 submitted layers to ovr.log

---
 ReviveXR/Common.h     |  8 +++++++-
 ReviveXR/REV_CAPI.cpp | 33 +++++++++++++++++++++++++++++++++
 2 files changed, 40 insertions(+), 1 deletion(-)

diff --git a/ReviveXR/Common.h b/ReviveXR/Common.h
index 6baac79..7b7c0d9 100644
--- a/ReviveXR/Common.h
+++ b/ReviveXR/Common.h
@@ -27,6 +27,12 @@ constexpr const wchar_t* ResultToString(XrResult e)
 
 extern XrResult g_LastResult;
 
+// Atrium OVR (native/atrium_ovr/src/main.cpp): %APPDATA%\Atrium\logs\ovr.log
+void AtriumOvrLog(const char* fmt, ...);
+void AtriumOvrLogFail(const char* call, int result, const char* file, int line);
+// At most once a second per call site, for per-frame traces.
+bool AtriumOvrEverySecond(long long* last);
+
 #ifdef NDEBUG
 #define assertmsg(expression, message) ((void)0)
 #else
@@ -40,7 +46,7 @@ extern XrResult g_LastResult;
 	{ \
 		g_LastResult = (x); \
 		assertmsg(XR_SUCCEEDED(g_LastResult), ResultToString(g_LastResult)); \
-		if (XR_FAILED(g_LastResult)) return ResultToOvrResult(g_LastResult); \
+		if (XR_FAILED(g_LastResult)) { AtriumOvrLogFail(#x, (int)g_LastResult, __FILE__, __LINE__); return ResultToOvrResult(g_LastResult); } \
 	}
 
 #define CHK_OVR(x) \
diff --git a/ReviveXR/REV_CAPI.cpp b/ReviveXR/REV_CAPI.cpp
index 3b6f180..37235b4 100644
--- a/ReviveXR/REV_CAPI.cpp
+++ b/ReviveXR/REV_CAPI.cpp
@@ -415,6 +415,15 @@ OVR_PUBLIC_FUNCTION(ovrTrackingState) ovr_GetTrackingState(ovrSession session, d
 		std::shared_lock<std::shared_mutex> lk(session->TrackingMutex);
 		session->Input->GetTrackingState(session, &state, absTime);
 	}
+	static long long lastTrace = 0;
+	if (AtriumOvrEverySecond(&lastTrace))
+	{
+		const ovrPosef& h = state.HeadPose.ThePose;
+		AtriumOvrLog("tracking: head flags 0x%x pos %+.3f %+.3f %+.3f rot %+.3f %+.3f %+.3f %+.3f; hands 0x%x 0x%x",
+			state.StatusFlags, h.Position.x, h.Position.y, h.Position.z,
+			h.Orientation.x, h.Orientation.y, h.Orientation.z, h.Orientation.w,
+			state.HandStatusFlags[0], state.HandStatusFlags[1]);
+	}
 	return state;
 }
 
@@ -1149,6 +1158,30 @@ OVR_PUBLIC_FUNCTION(ovrResult) ovr_EndFrame(ovrSession session, long long frameI
 	if (frameIndex < TargetFrame->frameIndex)
 		TargetFrame = &session->FrameStats[frameIndex % ovrMaxProvidedFrameStats];
 
+	static long long lastTrace = 0;
+	if (AtriumOvrEverySecond(&lastTrace))
+	{
+		AtriumOvrLog("frame %lld: %u layers in, %u out, predicted %lld, shouldRender %d", frameIndex, layerCount,
+			(unsigned)layers.size(), (long long)TargetFrame->predictedDisplayTime, (int)TargetFrame->shouldRender);
+		for (unsigned int l = 0; l < layerCount; l++)
+		{
+			const ovrLayerHeader* h = layerPtrList[l];
+			if (!h)
+				continue;
+			const ovrLayer_Union* u = (const ovrLayer_Union*)h;
+			if (h->Type == ovrLayerType_EyeFov || h->Type == ovrLayerType_EyeFovDepth)
+			{
+				const ovrPosef& p = u->EyeFov.RenderPose[0];
+				AtriumOvrLog("  layer %u: type %d flags 0x%x%s, left eye pos %+.3f %+.3f %+.3f rot %+.3f %+.3f %+.3f %+.3f, sensor time %.3f",
+					l, (int)h->Type, h->Flags, (h->Flags & ovrLayerFlag_HeadLocked) ? " (head-locked)" : "",
+					p.Position.x, p.Position.y, p.Position.z, p.Orientation.x, p.Orientation.y, p.Orientation.z, p.Orientation.w,
+					u->EyeFov.SensorSampleTime);
+			}
+			else
+				AtriumOvrLog("  layer %u: type %d flags 0x%x", l, (int)h->Type, h->Flags);
+		}
+	}
+
 	XrFrameEndInfo endInfo = XR_TYPE(FRAME_END_INFO);
 	endInfo.displayTime = TargetFrame->predictedDisplayTime;
 	endInfo.environmentBlendMode = XR_ENVIRONMENT_BLEND_MODE_OPAQUE;
-- 
