From cc9f5eebc6d5bf65b2877e5756a040a56639a154 Mon Sep 17 00:00:00 2001
From: Atrium <atrium@localhost>
Date: Tue, 20 Oct 2026 11:56:15 +0100
Subject: [PATCH 4/7] Atrium OVR: D3D12 swapchains use the negotiated format;
 trace swapchains and runtime formats

---
 ReviveXR/Session.cpp        | 6 ++++++
 ReviveXR/SwapchainD3D12.cpp | 9 ++++++++-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/ReviveXR/Session.cpp b/ReviveXR/Session.cpp
index 7668794..6dda118 100644
--- a/ReviveXR/Session.cpp
+++ b/ReviveXR/Session.cpp
@@ -189,6 +189,12 @@ ovrResult ovrHmdStruct::StartSession(void* graphicsBinding)
 	SupportedFormats.resize(formatCount);
 	CHK_XR(xrEnumerateSwapchainFormats(Session, (uint32_t)SupportedFormats.size(), &formatCount, SupportedFormats.data()));
 	assert(formatCount == SupportedFormats.size());
+	{
+		std::string list;
+		for (int64_t f : SupportedFormats)
+			list += std::to_string(f) + " ";
+		AtriumOvrLog("runtime swapchain formats: %s", list.c_str());
+	}
 
 	Running.second.notify_all();
 
diff --git a/ReviveXR/SwapchainD3D12.cpp b/ReviveXR/SwapchainD3D12.cpp
index 2eb6e24..ca694be 100644
--- a/ReviveXR/SwapchainD3D12.cpp
+++ b/ReviveXR/SwapchainD3D12.cpp
@@ -94,8 +94,15 @@ ovrResult ovrTextureSwapChainD3D12::Create(ovrSession session, ID3D12CommandQueu
 	assert(session->SupportsFormat(format));
 
 	ovrTextureSwapChainD3D12* chain = new ovrTextureSwapChainD3D12(queue);
-	CHK_OVR(chain->Init(session->Session, desc, TextureFormatToDXGIFormat(desc->Format)));
+	// Atrium OVR (after EchoXR): create the images in the negotiated format, as the D3D11 path does.
+	// Upstream created them in the requested format while giving the game views in the negotiated
+	// one; on a runtime that doesn't offer the requested format (Meta's) the game's drawing never
+	// reached the images, so the compositor showed a stale picture at the current head pose.
+	CHK_OVR(chain->Init(session->Session, desc, format));
 	CHK_OVR(chain->EnumerateImages<XrSwapchainImageD3D12KHR>(XR_TYPE_SWAPCHAIN_IMAGE_D3D12_KHR));
+	AtriumOvrLog("swapchain %s: ovr format %d -> dxgi %d, created as %d; %dx%d, array %d, mips %d, samples %d, misc 0x%x, bind 0x%x, %u images",
+		"D3D12", (int)desc->Format, (int)TextureFormatToDXGIFormat(desc->Format), (int)format, desc->Width, desc->Height,
+		desc->ArraySize, desc->MipLevels, desc->SampleCount, desc->MiscFlags, desc->BindFlags, chain->Length);
 
 	// If the app doesn't expect a typeless texture we need to attach the fully qualified format to each texture.
 	// Depth formats are always considered typeless in the Oculus SDK, so no need to hook those.
-- 
2.52.0.windows.1

