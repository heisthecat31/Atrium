+// Atrium OVR: the field-of-view probe opens a session and (on Meta's runtime) waits for READY,
+// which only comes once the headset is worn. Its result is cached per runtime + headset in
+// %APPDATA%\Atrium\ovr_fov_cache.txt so later launches skip the probe.
+static void AtriumFovCachePath(char* out, size_t size)
+{
+	const char* appdata = getenv("APPDATA");
+	snprintf(out, size, "%s\\Atrium\\ovr_fov_cache.txt", appdata ? appdata : ".");
+}
+
+// One line per runtime + headset: key, then per eye the FOV (4) and the eye pose relative to the
+// head (orientation xyzw, position xyz: the IPD lives here), then the stage bounds.
+static bool AtriumFovCacheLoad(const char* key, XrFovf fov[2], XrPosef pose[2], XrExtent2Df* bounds)
+{
+	char path[MAX_PATH];
+	AtriumFovCachePath(path, sizeof(path));
+	FILE* f = nullptr;
+	if (fopen_s(&f, path, "r") != 0 || !f)
+		return false;
+	char line[1024];
+	bool found = false;
+	while (!found && fgets(line, sizeof(line), f))
+	{
+		char* tab = strchr(line, '\t');
+		if (!tab)
+			continue;
+		*tab = 0;
+		if (strcmp(line, key) != 0)
+			continue;
+		int n = 0;
+		const char* p = tab + 1;
+		float v[24];
+		while (n < 24)
+		{
+			char* end = nullptr;
+			v[n] = strtof(p, &end);
+			if (end == p)
+				break;
+			p = end;
+			n++;
+		}
+		if (n != 24)
+			continue; // an older line without eye poses: probe again
+		for (int i = 0; i < 2; i++)
+		{
+			const float* e = v + i * 11;
+			fov[i] = { e[0], e[1], e[2], e[3] };
+			pose[i].orientation = { e[4], e[5], e[6], e[7] };
+			pose[i].position = { e[8], e[9], e[10] };
+		}
+		bounds->width = v[22];
+		bounds->height = v[23];
+		found = true;
+	}
+	fclose(f);
+	return found;
+}
+
+static void AtriumFovCacheSave(const char* key, const XrFovf fov[2], const XrPosef pose[2], const XrExtent2Df& bounds)
+{
+	char path[MAX_PATH];
+	AtriumFovCachePath(path, sizeof(path));
+	// Keep other headsets' lines, replace this one.
+	std::string kept;
+	FILE* f = nullptr;
+	if (fopen_s(&f, path, "r") == 0 && f)
+	{
+		char line[1024];
+		size_t keylen = strlen(key);
+		while (fgets(line, sizeof(line), f))
+			if (!(strncmp(line, key, keylen) == 0 && line[keylen] == '\t'))
+				kept += line;
+		fclose(f);
+	}
+	if (fopen_s(&f, path, "w") != 0 || !f)
+		return;
+	fputs(kept.c_str(), f);
+	fprintf(f, "%s\t", key);
+	for (int i = 0; i < 2; i++)
+		fprintf(f, "%f %f %f %f %f %f %f %f %f %f %f ", fov[i].angleLeft, fov[i].angleRight, fov[i].angleUp,
+			fov[i].angleDown, pose[i].orientation.x, pose[i].orientation.y, pose[i].orientation.z,
+			pose[i].orientation.w, pose[i].position.x, pose[i].position.y, pose[i].position.z);
+	fprintf(f, "%f %f\n", bounds.width, bounds.height);
+	fclose(f);
+}
 
